rules_version = '2';

// RoadMate AU security rules.
// Identity may be anonymous Firebase Auth or optional social sign-in.
// Posture: signed-in users may read sites/reports; cast status votes (validated
// so a vote bumps exactly one counter by 1); post activity reports; save sites
// under their own uid; and submit NEW sites as *pending* (approved == false).
// Official seeded sites (approved == true) and moderation actions are
// admin-managed.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isInitialAdminEmail() {
      return signedIn()
        && request.auth.token.email in [
          'r3procamel@gmail.com',
          'hello@adrian2045.com',
          'adrian@darumatic.com'
        ];
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/userRoles/$(request.auth.uid))
        && get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role == 'admin';
    }

    match /sites/{siteId} {
      allow read: if true;

      // Community-submitted sites are created as pending (approved == false);
      // they only become visible after a moderator approves them. Admins may
      // create sites already approved — published immediately (issue #16).
      allow create: if signedIn()
        && isValidNewSite()
        && (request.resource.data.approved == false
          || (request.resource.data.approved == true && isAdmin()));

      // Two permitted update shapes:
      //  - a validated status vote (one counter +1, valid status), or
      //  - a bare lastReportAt touch (accompanies an activity report).
      // Both must stamp the rate-limit ledger in the same batch (issue #15).
      allow update: if isAdmin()
        || (signedIn() && (isValidVote(siteId) || isReportTouch(siteId)));

      // Admins may remove a site outright (issue #13); the client deletes the
      // reports/limits subcollections in the same batch (nested rules allow it).
      allow delete: if isAdmin();

      match /reports/{reportId} {
        allow read: if true;
        allow create: if signedIn() && isValidReport(siteId);
        allow update: if false;
        allow delete: if isAdmin();
      }

      // Per-user rate-limit ledger (issue #15): one doc per user per site with
      // the user's last vote/report time. Every vote/report batch must set the
      // matching field to request.time (enforced via getAfter() in the rules
      // above), and updating a field is only allowed once its cooldown has
      // passed — so a spammy second write rejects the whole batch.
      // Cooldowns MUST match lib/services/rate_limit.dart (5 min / 2 min).
      match /limits/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow create: if signedIn()
          && request.auth.uid == uid
          && validLimitKeys()
          && limitStampsAreNow();
        allow update: if signedIn()
          && request.auth.uid == uid
          && validLimitKeys()
          && voteStampOk()
          && reportStampOk();
        allow delete: if isAdmin();
      }
    }

    // Authorises the admin moderation feed's collectionGroup('reports') query.
    // Rules v2 does not apply the nested /sites/{id}/reports rule to collection
    // group queries — those need a recursive-wildcard match. Per-doc reads stay
    // governed by the nested rule above (public); this only gates the group scan.
    match /{path=**}/reports/{reportId} {
      allow read: if isAdmin();
    }

    match /userRoles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn()
        && request.auth.uid == uid
        && isInitialAdminEmail()
        && request.resource.data.keys().hasOnly([
          'role', 'email', 'bootstrappedAt'
        ])
        && request.resource.data.role == 'admin'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.bootstrappedAt == request.time;
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'email', 'displayName', 'photoUrl', 'isAnonymous', 'lastSeenAt'
        ]);
      allow delete: if false;

      // A user's favourite sites live under their own uid and are private to them.
      match /favourites/{siteId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }
    function affectedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // --- Rate limiting (issue #15) -----------------------------------------
    // The user's ledger doc *after* this batch commits must carry a stamp equal
    // to request.time — proving the batch also wrote the ledger, whose own rule
    // enforces the cooldown.
    function votedNow(siteId) {
      return getAfter(/databases/$(database)/documents/sites/$(siteId)/limits/$(request.auth.uid))
        .data.lastVoteAt == request.time;
    }

    function reportedNow(siteId) {
      return getAfter(/databases/$(database)/documents/sites/$(siteId)/limits/$(request.auth.uid))
        .data.lastReportAt == request.time;
    }

    function validLimitKeys() {
      return request.resource.data.keys().hasOnly(['lastVoteAt', 'lastReportAt']);
    }

    // First ledger doc for this user+site: any present stamp must be "now".
    function limitStampsAreNow() {
      return (!('lastVoteAt' in request.resource.data)
          || request.resource.data.lastVoteAt == request.time)
        && (!('lastReportAt' in request.resource.data)
          || request.resource.data.lastReportAt == request.time);
    }

    // A changed stamp must be "now" AND the previous one (if any) must be older
    // than the cooldown. Votes: 5 minutes.
    function voteStampOk() {
      return !affectedKeys().hasAny(['lastVoteAt'])
        || (request.resource.data.lastVoteAt == request.time
          && (!('lastVoteAt' in resource.data)
            || request.time > resource.data.lastVoteAt + duration.value(5, 'm')));
    }

    // Activity reports: 2 minutes.
    function reportStampOk() {
      return !affectedKeys().hasAny(['lastReportAt'])
        || (request.resource.data.lastReportAt == request.time
          && (!('lastReportAt' in resource.data)
            || request.time > resource.data.lastReportAt + duration.value(2, 'm')));
    }
    // ------------------------------------------------------------------------

    // Exactly one of the three status counters increases by 1; none decrease;
    // currentStatus is a valid value; no other fields change. Must be batched
    // with a fresh rate-limit ledger stamp.
    function isValidVote(siteId) {
      let a = resource.data;
      let b = request.resource.data;
      return affectedKeys().hasOnly(
               ['openVotes', 'blitzVotes', 'closedVotes',
                'currentStatus', 'lastReportAt'])
        && b.currentStatus in ['open', 'blitz', 'closed']
        && b.openVotes >= a.openVotes
        && b.blitzVotes >= a.blitzVotes
        && b.closedVotes >= a.closedVotes
        && (b.openVotes + b.blitzVotes + b.closedVotes)
             == (a.openVotes + a.blitzVotes + a.closedVotes) + 1
        && votedNow(siteId);
    }

    function isReportTouch(siteId) {
      return affectedKeys().hasOnly(['lastReportAt']) && reportedNow(siteId);
    }

    function isValidReport(siteId) {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'siteId', 'status', 'activityType', 'activityNote', 'reporterName',
          'uid', 'createdAt'
        ])
        && d.uid == request.auth.uid
        && d.siteId == siteId
        && d.createdAt == request.time
        && (isValidStatusReport(d, siteId) || isValidActivityReport(d, siteId));
    }

    function isValidStatusReport(d, siteId) {
      return d.keys().hasOnly(['siteId', 'status', 'uid', 'createdAt'])
        && d.status is string
        && d.status in ['open', 'blitz', 'closed']
        && votedNow(siteId);
    }

    function isValidActivityReport(d, siteId) {
      return d.keys().hasOnly([
          'siteId', 'activityType', 'activityNote', 'reporterName',
          'uid', 'createdAt'
        ])
        && d.activityType is string
        && d.activityType in [
          'longQueue', 'delays', 'policePresent', 'BGD',
          'Camera Only', 'other'
        ]
        && (!('activityNote' in d.keys())
          || (d.activityNote is string && d.activityNote.size() <= 500))
        && (!('reporterName' in d.keys())
          || (d.reporterName is string
            && d.reporterName.size() > 0
            && d.reporterName.size() <= 80))
        && reportedNow(siteId);
    }

    // Shared shape for any client-created site; the create rule adds the
    // approved-flag gate (false for everyone, true only for admins).
    function isValidNewSite() {
      let d = request.resource.data;
      return d.approved is bool
        && d.createdBy == request.auth.uid
        && d.name is string && d.name.size() > 0
        && d.state is string
        && d.type is string
        && d.address is string;
    }
  }
}
