rules_version = '2';

// RoadMate AU security rules.
// Identity may be anonymous Firebase Auth or optional social sign-in.
// Posture: signed-in users may read sites/reports; cast status votes (validated
// so a vote bumps exactly one counter by 1); post activity reports; save sites
// under their own uid; and submit NEW sites as *pending* (approved == false).
// Official seeded sites (approved == true) and moderation actions are
// admin-managed.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isInitialAdminEmail() {
      return signedIn()
        && request.auth.token.email in [
          'r3procamel@gmail.com',
          'hello@adrian2045.com',
          'adrian@darumatic.com',
          'leandropervieux@hotmail.com',
        ];
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/userRoles/$(request.auth.uid))
        && get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role == 'admin';
    }

    // Spam control: an admin bans a uid by creating bans/{uid}. While the ban
    // is active that uid may not WRITE anything — votes, reports, new sites,
    // favourites, profile syncs. Reads are untouched, so a banned spammer can
    // still use the app; they just can't post.
    //
    // exists() first, then get() only when a ban document is actually there —
    // the same shape as isAdmin() above, and for the same reason: binding the
    // get() result and null-checking it raises "Null value error" for everyone
    // *without* a ban, which would deny every ordinary write (caught by the
    // 'an unbanned user is unaffected' check in the rules suite). So the
    // common case costs one lookup, a banned one costs two, and only ever on
    // write paths — the read budget in CLAUDE.md is about listeners, which
    // this never touches.
    //
    // A doc with no `until` is a permanent ban, and a malformed `until` is
    // treated the same way: a half-written ban must fail CLOSED, never open.
    function isBanned() {
      return signedIn()
        && exists(/databases/$(database)/documents/bans/$(request.auth.uid))
        && banAllowsNothing(
             get(/databases/$(database)/documents/bans/$(request.auth.uid)).data
           );
    }

    function banAllowsNothing(ban) {
      return !('until' in ban)
        || !(ban.until is timestamp)
        || ban.until > request.time;
    }

    // Bans are visible to the banned user (so the app can say why a post was
    // refused) and to admins; only admins write them.
    match /bans/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if isAdmin() && isValidBan();
      allow delete: if isAdmin();
    }

    match /sites/{siteId} {
      allow read: if true;

      // Community-submitted sites are created as pending (approved == false);
      // they only become visible after a moderator approves them. Admins may
      // create sites already approved — published immediately (issue #16).
      allow create: if signedIn()
        && !isBanned()
        && isValidNewSite()
        && (request.resource.data.approved == false
          || (request.resource.data.approved == true && isAdmin()));

      // Two permitted update shapes:
      //  - a validated status vote (one counter +1, valid status), or
      //  - a bare lastReportAt touch (accompanies an activity report).
      // isAdmin() comes first so a moderator's write never pays the ban read.
      allow update: if isAdmin()
        || (signedIn() && (isValidVote() || isReportTouch()) && !isBanned());

      // Admins may remove a site outright (issue #13); the client deletes the
      // reports/limits subcollections in the same batch (nested rules allow it).
      allow delete: if isAdmin();

      match /reports/{reportId} {
        allow read: if true;
        allow create: if signedIn() && !isBanned() && isValidReport(siteId);
        // Admins may edit an activity report's content (type/note/name); the
        // result must still be a valid activity report and identity fields
        // (siteId/uid/createdAt) stay frozen. Status votes remain immutable —
        // their counters live on the site doc, so moderation goes through
        // deleteReport's recount instead.
        allow update: if isAdmin()
          && affectedKeys().hasOnly([
            'activityType', 'activityNote', 'reporterName'
          ])
          && isValidActivityReport(request.resource.data);
        allow delete: if isAdmin();
      }

      // Legacy rate-limit ledger docs (rolled-back issue #15): no longer
      // written; admins can still read/purge them (site deletion cleans up).
      match /limits/{uid} {
        allow read, delete: if isAdmin();
        allow create, update: if false;
      }
    }

    // Authorises collectionGroup('reports') queries: every client's shared
    // 10h recent-reports listener (one query feeds all site cards — read
    // cost) plus the admin moderation feed. Rules v2 does not apply the
    // nested /sites/{id}/reports rule to collection group queries — those
    // need a recursive-wildcard match. Reports were already world-readable
    // per-site via the nested rule above, so this widens nothing.
    match /{path=**}/reports/{reportId} {
      allow read: if true;
    }

    match /userRoles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn()
        && request.auth.uid == uid
        && isInitialAdminEmail()
        && request.resource.data.keys().hasOnly([
          'role', 'email', 'bootstrappedAt'
        ])
        && request.resource.data.role == 'admin'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.bootstrappedAt == request.time;
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // `username` (0.1.61, road names) is additive: shipped clients'
      // 5-key profile syncs keep passing. Anonymous users write this doc too
      // now (their road name is its only content) — signedIn() covers them.
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && !isBanned()
        && request.resource.data.keys().hasOnly([
          'email', 'displayName', 'photoUrl', 'isAnonymous', 'lastSeenAt',
          'username'
        ])
        && (!('username' in request.resource.data.keys())
          || (request.resource.data.username is string
            && request.resource.data.username.size() >= 3
            && request.resource.data.username.size() <= 30));
      // In-app account deletion (App Store 5.1.1(v)): a user erases their
      // own profile before deleting the Firebase account. NOT gated on the
      // ban — a suspended user keeps the right to delete their account, and
      // Apple requires that path to work unconditionally.
      allow delete: if signedIn() && request.auth.uid == uid;

      // A user's favourite sites live under their own uid and are private to
      // them. Adding one is a write and stops while banned; removing one does
      // not, so nobody is left holding a star they cannot clear (and the
      // deletion batch above keeps working).
      match /favourites/{siteId} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && !isBanned();
      }

      // Global per-user action ledger (issue #15 redux): 5 votes/reports per
      // 5 minutes across all sites. New clients stamp this doc in the same
      // batch as every vote/report; the whole batch fails when the stamp is
      // rejected. All time judgments use request.time — the device clock
      // choosing the reset-vs-increment branch caused the 2026-07-07 rollback
      // and must never decide again. Old released clients don't write the
      // ledger and stay unthrottled (retrocompat) until a future strict phase.
      //
      // Admins are exempt: moderating a blitz means a burst of votes/reports
      // and the 5-per-5-minutes cap must never stand in their way. The
      // exemption lives here (not in the client) so every shipped build gets
      // it, and it sits LAST in the `||` chain so the ordinary in-window path
      // short-circuits before the userRoles lookup. `create` needs no clause:
      // it only ever carries the reset shape, which is always allowed.
      match /limits/actions {
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow create: if signedIn() && request.auth.uid == uid
          && isLedgerReset();
        allow update: if signedIn() && request.auth.uid == uid
          && (isLedgerIncrement()
            || (isLedgerReset() && ledgerWindowExpired())
            || isAdmin());
        // Owner: account-deletion cleanup. Admin: moderation purge.
        allow delete: if signedIn()
          && (request.auth.uid == uid || isAdmin());
      }

      // Participation stats (points/levels/badges — purely cosmetic). A new
      // path no shipped client writes, so everything here is additive: old
      // 2-op/3-op vote+report batches carry no stats write and keep passing.
      // New clients bump exactly one counter by 1 in the same batch as the
      // vote/report (set with merge, FieldValue.increment), so create carries
      // the full seeded shape too.
      //
      // Anti-cheat is deliberately soft: owner-only, +1-per-write, banned
      // users refused, updatedAt server-stamped — and nothing more.
      // getAfter() linkage is not viable in either direction (old clients'
      // batches have no stats write; the report doc ID is random), and a
      // scripted standalone +1 earns points no faster than scripting real
      // votes, which the action ledger above already caps at 5/5min. A
      // future strict phase could require
      // getAfter(limits/actions).lastActionAt == request.time here.
      match /stats/participation {
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow create: if signedIn() && request.auth.uid == uid
          && !isBanned()
          && isStatsSeed();
        allow update: if signedIn() && request.auth.uid == uid
          && !isBanned()
          && isStatsIncrement();
        // Owner: account-deletion cleanup. Admin: moderation purge.
        // Un-banned like limits/actions so the deletion batch keeps working.
        allow delete: if signedIn()
          && (request.auth.uid == uid || isAdmin());
      }
    }

    // Road-name uniqueness claims (0.1.61): usernames/{key} where key is the
    // lowercased name, so "Dusty Nomad" and "DUSTY NOMAD" collide. Claiming
    // is create-if-free — a second create of the same key arrives as an
    // update and dies on the owner check, which is the whole uniqueness
    // guarantee. The display-cased name is denormalized onto
    // users/{uid}.username in the same transaction (username_store.dart).
    // World-readable: names are already public on every report, and the
    // client reads a claim to explain a lost create race.
    match /usernames/{nameKey} {
      allow read: if true;
      allow create: if signedIn() && !isBanned() && isValidUsernameClaim(nameKey);
      // Owner may re-stamp their claim (casing change keeps the same key).
      allow update: if signedIn()
        && !isBanned()
        && resource.data.uid == request.auth.uid
        && isValidUsernameClaim(nameKey);
      // Owner: rename release / account deletion (the latter deliberately
      // un-banned, like the users/{uid} delete). Admin: moderation.
      allow delete: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // Shape of a road-name claim. Length caps and character set must stay in
    // sync with lib/services/username_logic.dart, or a name the client
    // accepts dies here with a generic error.
    function isValidUsernameClaim(nameKey) {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid', 'username', 'createdAt'])
        && d.uid == request.auth.uid
        && d.username is string
        && d.username.lower() == nameKey
        && d.createdAt == request.time
        && nameKey.size() >= 3
        && nameKey.size() <= 30
        && nameKey.matches('[a-z0-9][a-z0-9 _-]*[a-z0-9]');
    }

    // Public app configuration (e.g. minVersion for the forced-update gate).
    // Readable pre-auth so the gate works before sign-in; written only from
    // the Firebase console / Admin SDK.
    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Admin -> all users broadcast: the one `announcements/current` doc every
    // client bands across the top of the app. World-readable like config (the
    // banner must work for anonymous users and before sign-in settles) and
    // admin-written. Clearing a notice is a delete, so admins own that too.
    match /announcements/{docId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidAnnouncement();
      allow delete: if isAdmin();
    }
    function affectedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Rate-limit ledger shapes (issue #15 redux). A reset starts a fresh
    // 5-minute window; an increment adds an action to the open window, capped
    // at 5. The client never consults its own clock: it tries increment, and
    // retries with reset when the server denies it. NOTE: the 5-action /
    // 5-minute values must match kMaxActionsPerWindow / kRateLimitWindow in
    // lib/services/rate_limit.dart.
    function isLedgerReset() {
      let d = request.resource.data;
      return d.keys().hasOnly(['count', 'windowStart', 'lastActionAt'])
        && d.count == 1
        && d.windowStart == request.time
        && d.lastActionAt == request.time;
    }

    function ledgerWindowExpired() {
      return request.time > resource.data.windowStart + duration.value(5, 'm');
    }

    function isLedgerIncrement() {
      let d = request.resource.data;
      return affectedKeys().hasOnly(['count', 'lastActionAt'])
        && d.count == resource.data.count + 1
        && d.count <= 5
        && d.lastActionAt == request.time
        && request.time <= resource.data.windowStart + duration.value(5, 'm');
    }

    // Participation stats shapes. The doc only ever holds the raw counters
    // (+ server-stamped updatedAt) — points/levels/badges are all computed
    // client-side (lib/services/participation_logic.dart), so the rules
    // never validate arithmetic beyond "+1 to exactly one counter".
    // `sitesAdded` (0.1.60, Trailblazer badge — credited at submission, not
    // approval) is read with get() defaults so docs and writes from 0.1.59
    // clients, which know only votes/reports, keep passing.
    function statsTotal(d) {
      return d.get('votes', 0) + d.get('reports', 0) + d.get('sitesAdded', 0);
    }

    function isStatsSeed() {
      let d = request.resource.data;
      return d.keys().hasOnly(['votes', 'reports', 'sitesAdded', 'updatedAt'])
        && d.get('votes', 0) is int
        && d.get('reports', 0) is int
        && d.get('sitesAdded', 0) is int
        && d.get('votes', 0) >= 0
        && d.get('reports', 0) >= 0
        && d.get('sitesAdded', 0) >= 0
        && statsTotal(d) == 1
        && d.updatedAt == request.time;
    }

    function isStatsIncrement() {
      let a = resource.data;
      let b = request.resource.data;
      return affectedKeys().hasOnly([
          'votes', 'reports', 'sitesAdded', 'updatedAt'
        ])
        && b.get('votes', 0) >= a.get('votes', 0)
        && b.get('reports', 0) >= a.get('reports', 0)
        && b.get('sitesAdded', 0) >= a.get('sitesAdded', 0)
        && statsTotal(b) == statsTotal(a) + 1
        && b.updatedAt == request.time;
    }

    // Exactly one of the three status counters increases by 1; none decrease;
    // currentStatus is a valid value; no other fields change.
    // NOTE: this phase deliberately does NOT require the ledger stamp here —
    // released mobile builds commit plain 2-op batches and must keep working
    // (CLAUDE.md retrocompat constraint). A future strict phase adds
    // getAfter(/users/$(uid)/limits/actions).lastActionAt == request.time.
    function isValidVote() {
      let a = resource.data;
      let b = request.resource.data;
      return affectedKeys().hasOnly(
               ['openVotes', 'blitzVotes', 'closedVotes',
                'currentStatus', 'lastReportAt'])
        && b.currentStatus in ['open', 'blitz', 'closed']
        && b.openVotes >= a.openVotes
        && b.blitzVotes >= a.blitzVotes
        && b.closedVotes >= a.closedVotes
        && (b.openVotes + b.blitzVotes + b.closedVotes)
             == (a.openVotes + a.blitzVotes + a.closedVotes) + 1;
    }

    function isReportTouch() {
      return affectedKeys().hasOnly(['lastReportAt']);
    }

    function isValidReport(siteId) {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'siteId', 'status', 'activityType', 'activityNote', 'reporterName',
          'reporterLevel', 'uid', 'createdAt'
        ])
        && d.uid == request.auth.uid
        && d.siteId == siteId
        && d.createdAt == request.time
        && (isValidStatusReport(d) || isValidActivityReport(d));
    }

    // `reporterName` (optional, 0.1.61 road names) signs the vote; absent
    // from every shipped client's 4-field docs — both shapes accepted.
    function isValidStatusReport(d) {
      return d.keys().hasOnly([
          'siteId', 'status', 'uid', 'createdAt', 'reporterName'
        ])
        && d.status is string
        && d.status in ['open', 'blitz', 'closed']
        && (!('reporterName' in d.keys())
          || (d.reporterName is string
            && d.reporterName.size() > 0
            && d.reporterName.size() <= 80));
    }

    // `reporterLevel` (optional) is the author's ladder index, denormalized
    // at write time so report rows show a level icon without per-author
    // profile reads. Absent from old clients' docs — both shapes accepted.
    // Capped loosely at 99 so adding ladder rungs never needs a rules deploy.
    function isValidActivityReport(d) {
      return d.keys().hasOnly([
          'siteId', 'activityType', 'activityNote', 'reporterName',
          'reporterLevel', 'uid', 'createdAt'
        ])
        && (!('reporterLevel' in d.keys())
          || (d.reporterLevel is int
            && d.reporterLevel >= 1
            && d.reporterLevel <= 99))
        && d.activityType is string
        && d.activityType in [
          'longQueue', 'delays', 'policePresent', 'BGD',
          'Camera Only', 'other'
        ]
        && (!('activityNote' in d.keys())
          || (d.activityNote is string && d.activityNote.size() <= 500))
        && (!('reporterName' in d.keys())
          || (d.reporterName is string
            && d.reporterName.size() > 0
            && d.reporterName.size() <= 80));
    }

    // A ban document (admin-written). `until` absent == permanent; `createdBy`
    // is the issuing admin and `createdAt` is server time, so the audit trail
    // can't be back-dated. Keys are capped so a ban can never smuggle in
    // fields another rule might read.
    function isValidBan() {
      let d = request.resource.data;
      return d.keys().hasOnly(['until', 'reason', 'createdAt', 'createdBy'])
        && d.createdBy == request.auth.uid
        && d.createdAt == request.time
        && (!('until' in d.keys()) || d.until is timestamp)
        && (!('reason' in d.keys())
          || (d.reason is string && d.reason.size() <= 200));
    }

    // An admin notice. Same shape discipline as isValidBan: a capped key set so
    // a notice can never smuggle in a field another rule might read,
    // server-stamped `publishedAt` so it can't be back-dated, and `publishedBy`
    // pinned to the issuing admin for the audit trail. The 280/480-char caps
    // must stay in sync with kAnnouncementMaxLength/kAnnouncementHtmlMaxLength
    // in lib/services/announcement.dart.
    //
    // `messageHtml` (rich subset, rendered by 0.1.68+) and `color` (#RRGGBB
    // background) are optional and additive; `message` stays required as the
    // plain-text fallback older clients render.
    function isValidAnnouncement() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'message', 'severity', 'publishedAt', 'publishedBy', 'expiresAt',
          'messageHtml', 'color'
        ])
        && d.message is string
        && d.message.size() > 0
        && d.message.size() <= 280
        && d.severity in ['info', 'warning']
        && d.publishedAt == request.time
        && d.publishedBy == request.auth.uid
        && (!('expiresAt' in d.keys()) || d.expiresAt is timestamp)
        && (!('messageHtml' in d.keys())
          || (d.messageHtml is string
            && d.messageHtml.size() > 0
            && d.messageHtml.size() <= 480))
        && (!('color' in d.keys())
          || (d.color is string && d.color.matches('#[0-9a-fA-F]{6}')));
    }

    // Shared shape for any client-created site; the create rule adds the
    // approved-flag gate (false for everyone, true only for admins).
    function isValidNewSite() {
      let d = request.resource.data;
      return d.approved is bool
        && d.createdBy == request.auth.uid
        // The submitter's road name (optional, 0.1.61), beside the uid.
        && (!('createdByName' in d.keys())
          || (d.createdByName is string
            && d.createdByName.size() > 0
            && d.createdByName.size() <= 80))
        && d.name is string && d.name.size() > 0
        && d.state is string
        && d.type is string
        && d.address is string;
    }
  }
}
